APP__PORT=8000
# stub | realesrgan (realesrgan needs weights in UPSCALE__MODEL_PATH)
UPSCALE__BACKEND=stub
UPSCALE__DEVICE=auto
UPSCALE__TILE_SIZE=512
# Default is SQLite in ./data; for PostgreSQL (docker compose up -d postgres):
# DATABASE__URL=postgresql://animeshka:animeshka@localhost:5432/animeshka
DATABASE__AUTO_MIGRATE=true
# false = API only queues jobs, run `uv run python -m src.worker` separately
WORKER__EMBEDDED=true
# Prometheus business metrics: API on /api/metrics, worker on :METRICS__WORKER_PORT/metrics
METRICS__ENABLED=true
METRICS__WORKER_PORT=9101
